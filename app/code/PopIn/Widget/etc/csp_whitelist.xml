<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="popin_widget_script" type="host">widget01.popin.to</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="popin_api" type="host">*.popin.to</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="popin_frame" type="host">*.popin.to</value>
            </values>
        </policy>
        <policy id="media-src">
            <values>
                <value id="popin_media" type="host">*.popin.to</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
